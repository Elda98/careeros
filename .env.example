# Copy to .env and fill in real values. Never commit .env (see .gitignore).

# --- Database ---
POSTGRES_USER=careeros
POSTGRES_PASSWORD=careeros_dev_password
POSTGRES_DB=careeros
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://careeros:careeros_dev_password@postgres:5432/careeros

# --- Cache ---
REDIS_URL=redis://redis:6379/0

# --- Auth (Clerk) ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Storage (Supabase Storage) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=careeros-documents

# --- LLM (Intelligence Layer agents) ---
# CareerOS uses Groq exclusively (langchain-groq's ChatGroq) — see ai/README.md.
# Optional: GROQ_MODEL to override the default (ai/careeros_ai/llm.py).
GROQ_API_KEY=

# --- Observability ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=careeros-dev
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- App ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Browser-reachable backend URL — used by client components and inlined
# into the frontend bundle. Under Docker Compose, server components instead
# use API_URL (set directly in docker-compose.yml to http://backend:8000,
# not from this file) since "localhost" inside the frontend container
# would otherwise resolve to the frontend container itself. See
# frontend/lib/api.ts.
NEXT_PUBLIC_API_URL=http://localhost:8000
ENVIRONMENT=development
